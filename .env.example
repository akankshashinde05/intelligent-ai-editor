# ==========================================
# Intelligent AI Editor Config
# ==========================================

# AI Configuration (Google Gemini API)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
APP_URL=

# Backend Daemon Configuration
BACKEND_HOST="127.0.0.1"
BACKEND_PORT=3000
ENVIRONMENT="development"
LOG_LEVEL="INFO"

# Terminal & Process Subsystem
DEFAULT_SHELL="powershell.exe"
PROCESS_TIMEOUT_SECONDS=30
MAX_OUTPUT_BUFFER_BYTES=5242880

# Security & Safety Policies
SAFETY_STRICT_MODE="true"
BLOCKED_COMMAND_PATTERNS="format,del /f /s /q c:,rmdir /s /q c:,:(){ :|:& };:"
REQUIRE_CONFIRMATION_FOR_HIGH_RISK="true"

# Database Configuration
DATABASE_URL="sqlite:///./data/intelligent_ai_editor.db"
ENABLE_WAL_MODE="true"

